{
  "manifest_version": 3,
  "name": "Facebook Comment Reader",
  "version": "0.4.0",
  "description": "Read visible Facebook comments aloud on the post you open.",
  "permissions": ["tabs", "clipboardWrite"],
  "action": { "default_title": "Comment reader", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
