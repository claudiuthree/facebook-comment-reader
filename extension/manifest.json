{
  "manifest_version": 3,
  "name": "Facebook Comment Reader Collector",
  "version": "0.3.1",
  "description": "Collect and listen to visible Facebook comments on the post, or send them to the reader tab.",
  "permissions": ["tabs", "clipboardWrite"],
  "action": { "default_title": "Comment reader", "default_popup": "popup.html" },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook-comment-reader.claudiuone.workers.dev/*",
    "https://comments.claudiuone.workers.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://facebook-comment-reader.claudiuone.workers.dev/*", "https://comments.claudiuone.workers.dev/*"],
      "js": ["reader-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["facebook-collector.js"],
      "run_at": "document_idle"
    }
  ]
}
